{
    "name": "ernestdefoe/buzz",
    "description": "Buzz — a live activity feed for Flarum. New discussions, replies, members, ranks, badges, streaks and more pop up across the whole forum as they happen, as a top ticker or bottom toasts. Every visitor only sees what they are allowed to see.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "activity",
        "live",
        "ticker",
        "toast",
        "feed"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "homepage": "https://github.com/ernestdefoe/buzz",
    "support": {
        "issues": "https://github.com/ernestdefoe/buzz/issues",
        "source": "https://github.com/ernestdefoe/buzz"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://buymeacoffee.com/ernestdefoe"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "suggest": {
        "flarum/realtime": "Events arrive the moment they happen instead of on the next poll.",
        "fof/badges": "Broadcast badges as members earn them.",
        "ernestdefoe/ladder": "Broadcast rank-ups.",
        "ernestdefoe/cadence": "Broadcast streak milestones.",
        "ernestdefoe/onramp": "Broadcast members finishing their onboarding quest.",
        "ernestdefoe/brainstorm": "Broadcast quizzes passed.",
        "ernestdefoe/curio": "Broadcast items added to public collections.",
        "ernestdefoe/client-area": "Broadcast store purchases."
    },
    "autoload": {
        "psr-4": {
            "Ernestdefoe\\Buzz\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ernestdefoe\\Buzz\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Buzz",
            "category": "feature",
            "icon": {
                "name": "fas fa-bolt",
                "backgroundColor": "#f59e0b",
                "color": "#fff"
            },
            "optional-dependencies": [
                "flarum/approval",
                "flarum/realtime",
                "flarum/suspend",
                "flarum/tags",
                "flarum/nicknames",
                "fof/badges",
                "ernestdefoe/ladder",
                "ernestdefoe/cadence",
                "ernestdefoe/onramp",
                "ernestdefoe/brainstorm",
                "ernestdefoe/curio",
                "ernestdefoe/client-area",
                "ernestdefoe/moments"
            ]
        }
    },
    "require-dev": {
        "flarum/approval": "^2.0",
        "flarum/phpstan": "^2.0",
        "flarum/suspend": "^2.0",
        "flarum/tags": "^2.0",
        "flarum/testing": "^2.0",
        "fof/badges": "^2.0"
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
